    "age":             {"short": "age",           "label": "age at diagnosis (y)"},
    "survival_time":   {"short": "survival",      "label": "overall survival (days)"}
  },

  "tumor_imaging_features": {
    "kits_tumor_volume_ml":      {"short": "tumor volume",        "label": "tumor volume (mL)"},
