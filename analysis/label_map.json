    "calcium":      {"short": "calcium",        "label": "calcium signaling"},
    "pi3k_akt":     {"short": "PI3K-AKT",       "label": "PI3K-AKT signaling"},
    "p53":          {"short": "p53",            "label": "p53 signaling"},
    "wnt":          {"short": "Wnt",            "label": "Wnt signaling"},
    "mapk":         {"short": "MAPK",           "label": "MAPK signaling"},
