    "liver_hu_mean":             {"short": "liver HU mean",       "label": "liver mean HU"},
    "liver_hu_std":              {"short": "liver HU std",        "label": "liver HU std."},

    "tumor_volume_ml":           {"short": "tumor volume",        "label": "tumor volume (mL)"},
    "tumor_breast_ratio":        {"short": "tumor/breast",        "label": "tumor / breast volume"},
    "tumor_heterogeneity":       {"short": "heterogeneity",       "label": "tumor heterogeneity"},
    "tumor_intensity_mean":      {"short": "intensity mean",      "label": "tumor intensity (mean)"},
    "tumor_intensity_std":       {"short": "intensity std",       "label": "tumor intensity (std.)"}
  },

