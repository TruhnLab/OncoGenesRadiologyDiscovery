{
  "_comment": "Mapping from internal column names to human-readable plot labels. 'label' strings use matplotlib mathtext ($...$ for math) and raw strings where backslashes appear. Feature names not in this map fall back to the raw column name.",

  "genetic_features": {
    "total_mutations":     {"short": "total mutations",     "label": "$N_{\\mathrm{total\\,mutations}}$"},
    "pathway_mutations":   {"short": "pathway mutations",   "label": "$N_{\\mathrm{pathway\\,mutations}}$"},
    "mean_ll_all":         {"short": "$\\overline{|\\Delta\\mathrm{LL}|}_{\\mathrm{all}}$",         "label": "$\\overline{|\\Delta\\mathrm{LL}|}_{\\mathrm{all}}$"},
    "mean_ll_pathway":     {"short": "$\\overline{|\\Delta\\mathrm{LL}|}_{\\mathrm{pathway}}$",     "label": "$\\overline{|\\Delta\\mathrm{LL}|}_{\\mathrm{pathway}}$"},
    "max_ll_all":          {"short": "$\\max|\\Delta\\mathrm{LL}|_{\\mathrm{all}}$",                "label": "$\\max|\\Delta\\mathrm{LL}|_{\\mathrm{all}}$"},
    "max_ll_pathway":      {"short": "$\\max|\\Delta\\mathrm{LL}|_{\\mathrm{pathway}}$",            "label": "$\\max|\\Delta\\mathrm{LL}|_{\\mathrm{pathway}}$"},
    "max_ll_nonpathway":   {"short": "$\\max|\\Delta\\mathrm{LL}|_{\\mathrm{non\\,pathway}}$",      "label": "$\\max|\\Delta\\mathrm{LL}|_{\\mathrm{non\\,pathway}}$"},
    "std_ll_pathway":      {"short": "$\\sigma_{|\\Delta\\mathrm{LL}|,\\,\\mathrm{pathway}}$",      "label": "$\\sigma_{|\\Delta\\mathrm{LL}|,\\,\\mathrm{pathway}}$"},
    "top3_mean_nonpw":     {"short": "top-3 $\\overline{|\\Delta\\mathrm{LL}|}_{\\mathrm{non-pathway}}$",  "label": "top-3 $\\overline{|\\Delta\\mathrm{LL}|}_{\\mathrm{non-pathway}}$"}
  },

  "clinical_features": {
